# Cardinal — LLM provider seam (lib/ai/provider.ts). Swapping providers for
# the real demo endpoint is a one-file change; these env vars are all that
# file reads.

# 'anthropic' (default) | 'openai' | 'azure'
CARDINAL_PROVIDER=anthropic

# Model id for the active provider. Defaults to 'claude-sonnet-5' when
# CARDINAL_PROVIDER=anthropic; required for 'openai' and 'azure'.
CARDINAL_MODEL=claude-sonnet-5

# Required when CARDINAL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Required when CARDINAL_PROVIDER=openai.
OPENAI_API_KEY=

# Required when CARDINAL_PROVIDER=azure. @ai-sdk/azure reads these two exact
# names (verified in node_modules/@ai-sdk/azure/dist/index.js).
AZURE_API_KEY=
AZURE_RESOURCE_NAME=

# Pins the seed data's "today" (YYYY-MM-DD) so relative story facts (e.g.
# "missed 12 days ago") hold on the actual demo date instead of the real
# today. Leave unset for normal dev — see lib/soe/seed/anchor.ts.
DEMO_ANCHOR_DATE=

# 'scripted' (default) | 'live'. Scripted mode (brief §8.1) runs all four
# agents off a deterministic script (lib/ai/scripted/) — full narration,
# evidence, and approval pauses with no API key and no network. If a
# provider IS configured above, scripted mode still tries the real model
# first for extra realism and falls back seamlessly on error/timeout
# (DEMO_LLM_TIMEOUT_MS below). 'live' bypasses all of this and always calls
# the real model, exactly like before W4.1 — see lib/ai/demo-mode.ts.
DEMO_MODE=scripted

# Scripted mode only, and only when a provider is also configured above: how
# long (ms) a single real doGenerate/doStream call may take — covering at
# least time-to-first-chunk — before that step falls back to the script.
# Default 8000 (brief §8.1's "~8s timeout"). See
# lib/ai/scripted/fallback-model.ts.
DEMO_LLM_TIMEOUT_MS=8000

# Scripted mode only: delay (ms) between each word-chunk of scripted
# narration, for a streaming feel with no real model in the loop (brief
# §8.3). Default 24. Set to 0 for tests and the replay verifier — see
# lib/ai/scripted/scripted-model.ts.
DEMO_SCRIPTED_DELAY_MS=24
